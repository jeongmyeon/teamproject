package com.project.mapper;

import java.util.List;
import java.util.Map;

import org.apache.ibatis.annotations.Insert;
import org.apache.ibatis.annotations.Mapper;
import org.apache.ibatis.annotations.Options;
import org.apache.ibatis.annotations.Param;
import org.apache.ibatis.annotations.Select;

import com.project.model.krhApplicationRequestVO;
import com.project.model.krhClubVO;
import com.project.model.krhTagVO;

@Mapper
public interface krhClubMapper {
	 // 클럽 전체 목록 조회
    @Select("SELECT * FROM club")
    List<krhClubVO> clubList();

    // 태그 10개 조회 (사용자에게 인기 태그 상위 10개)
    @Select("SELECT t.tagName, t.tagId, COUNT(*) AS tagCount " +
            "FROM tag t " +
            "JOIN clubtag ct ON t.tagId = ct.tagId " +
            "GROUP BY t.tagId " +
            "ORDER BY tagCount DESC " +
            "LIMIT 10")
    List<krhTagVO> tagList();

    // 특정 태그에 맞는 클럽 조회
    @Select("SELECT c.* FROM club c " +
            "JOIN clubtag ct ON c.clubId = ct.clubId " +
            "WHERE ct.tagId = #{tagId}")
    List<krhClubVO> clubtagList(@Param("tagId") int tagId);

    // 클럽 검색
    @Select("SELECT * FROM club " +
            "WHERE clubName LIKE CONCAT('%', #{keyword}, '%') " +
            "OR location LIKE CONCAT('%', #{keyword}, '%') " +
            "ORDER BY clubId DESC")
    List<krhClubVO> searchClub(@Param("keyword") String keyword);

    // 클럽 삽입
    @Insert("INSERT INTO club (clubName, clubFeatures, location, date, recruiterEmail, clubImage, clubUrl, createdAt) " +
            "VALUES (#{clubName}, #{clubFeatures}, #{location}, #{date}, #{recruiterEmail}, #{clubImage}, #{clubUrl}, NOW())")
    @Options(useGeneratedKeys = true, keyProperty = "clubId")
    void insertClub(krhClubVO krhclubVO);

    // 태그 삽입 (존재하지 않으면 삽입)
    @Insert({
        "<script>",
        "<foreach collection='hashtags' item='hashtag' separator=';'>",
        "INSERT INTO tag (tagName) ",
        "SELECT #{hashtag} FROM DUAL ",
        "WHERE NOT EXISTS (SELECT 1 FROM tag WHERE tagName = #{hashtag})",
        "</foreach>",
        "</script>"
    })
    void insertTagIfNotExist(@Param("hashtags") List<String> hashtags);

    // 클럽과 태그 연결
    @Insert({
        "<script>",
        "<foreach collection='hashtags' item='hashtag' separator=';'>",
        "INSERT INTO clubtag (clubId, tagId) ",
        "SELECT #{clubId}, t.tagId FROM tag t WHERE t.tagName = #{hashtag}",
        "</foreach>",
        "</script>"
    })
    void linkPostHashtags(@Param("clubId") int clubId, @Param("hashtags") List<String> hashtags);

    // 클럽 단건 조회
    @Select("SELECT * FROM club WHERE clubId=#{clubId}")
    krhClubVO getClubById(@Param("clubId") int clubId);

    // 클럽 주최자 이메일 조회
    @Select("SELECT recruiterEmail FROM club WHERE clubId=#{clubId}")
    String getEmailbyId(@Param("clubId") int clubId);

    // 클럽 신청
    @Insert("INSERT INTO applications (clubId, applicantName, applicantEmail, applicantAge, applicantGender, applyDate, privacyAgreement) " +
            "VALUES (#{clubId}, #{applicantName}, #{applicantEmail}, #{applicantAge}, #{applicantGender}, NOW(), #{privacyAgreement})")
    void insertApplication(krhApplicationRequestVO apvo);
}
